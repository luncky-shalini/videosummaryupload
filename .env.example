# ==============================================================================
# AI Video Synopsis & Meeting Transcription Platform - Environment Variables
# ==============================================================================

# GROQ API (Required for Whisper transcription and Llama-3.3 summarization)
# Obtain your API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_CHAT_MODEL=qwen/qwen3.8-27b

# SUPABASE CONFIGURATION (PostgreSQL Database, Auth, Storage)
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...your_publishable_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your_server_only_service_role_secret
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_for_token_verification

# GOOGLE OAUTH CREDENTIALS (Configured in Google Cloud Console & Supabase Provider)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# APPLICATION URLS & CORS CONFIGURATION
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-vercel-domain.vercel.app

# STORAGE CONFIGURATION & PROCESSING LIMITS
# Use "supabase" in production (especially on Vercel) to support direct-to-storage signed uploads
# and bypass Vercel's 4.5MB serverless request body limitation. Defaults to "local" for local dev.
MEDIA_STORAGE_TYPE=supabase
STORAGE_BUCKET_NAME=media-vault
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=500

# YOUTUBE IMPORT CONFIGURATION (yt-dlp)
# Optional cookies for YouTube bot verification bypass:
# 1. Path to Netscape cookies file (for local/Docker):
# YOUTUBE_COOKIES_PATH=./cookies.txt
# 2. Raw Netscape cookie content in environment variable (recommended for Vercel/cloud secrets):
# YOUTUBE_COOKIES_CONTENT="# Netscape HTTP Cookie File\n..."
# 3. Optional Proof of Origin (PO) token and visitor data:
# YOUTUBE_PO_TOKEN="web+..."
# YOUTUBE_VISITOR_DATA="visit_token_here"
# 4. Optional custom Node.js/Deno/Bun executable path:
# YOUTUBE_JS_RUNTIME_PATH=/usr/bin/node
# 5. Optional proxy (HTTP/SOCKS5):
# YOUTUBE_PROXY=http://proxy-server:port
