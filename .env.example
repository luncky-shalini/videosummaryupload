# ==============================================================================
# AI Video Synopsis & Meeting Transcription Platform - Environment Variables
# ==============================================================================

# GROQ API (Required for Whisper transcription and Llama-3.3 summarization)
# Obtain your API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# SUPABASE CONFIGURATION (PostgreSQL Database, Auth, Storage)
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...your_publishable_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your_server_only_service_role_secret
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_for_token_verification

# GOOGLE OAUTH CREDENTIALS (Configured in Google Cloud Console & Supabase Provider)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# APPLICATION URLS & CORS CONFIGURATION
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-vercel-domain.vercel.app

# STORAGE & PROCESSING LIMITS
MEDIA_STORAGE_TYPE=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=500
