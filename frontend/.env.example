# ==============================================================================
# Frontend Environment Variables (Configure these in Vercel Project Settings)
# ==============================================================================

# Supabase Project URL (From Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public Key (Do NOT use the secret service_role key here)
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your_publishable_anon_key

# Backend API Base URL
# For local development: http://localhost:8000
# For Vercel production: Set to your hosted backend URL (e.g. https://your-backend.onrender.com)
VITE_BACKEND_URL=http://localhost:8000
